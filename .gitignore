__pycache__/
*.pyc
*.pyo
sdk-tmp/

# Rust build artifacts
target/
*.rmeta
*.rlib

# C++ build artifacts
*.o
*.a
*.so
*.dylib

# Generated temp files
json-field-pages.md

# Snippet-runner scratch outputs that land in the repo root/scripts via relative
# paths (BulkWriter parquet dirs, results.json) — legacy guard; runners now
# write to $TMPDIR/milvus-snippet-run/<lang> instead
update-user-guide-snippet/results.json
update-user-guide-snippet/scripts/bulk_writer/

# Milvus server runtime data (docker compose bind mounts, created on startup)
milvus-server-launch/*/volumes/

# Debug / temp scratch files (never commit)
*_debug.*
*_debug_tmp.*
*_tmp.*
*.tmp

# ...except the skill's cleanup utility, whose name merely contains _tmp
!update-user-guide-snippet/scripts/cleanup_tmp.py
